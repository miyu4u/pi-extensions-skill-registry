{
  "rootDir": "..",
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/__test__"
  ],
  "testMatch": [
    "<rootDir>/__test__/__e2e__/**/*.e2e-spec.ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript"
          },
          "target": "es2022"
        },
        "module": {
          "type": "es6"
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleFileExtensions": [
    "ts",
    "js",
    "json"
  ]
}