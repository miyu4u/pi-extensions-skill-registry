{
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/src"
  ],
  "testMatch": [
    "<rootDir>/src/**/*.spec.ts"
  ],
  "testPathIgnorePatterns": [
    "<rootDir>/.*\\.bun\\.spec\\.ts$"
  ],
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript"
          },
          "target": "es2022"
        },
        "module": {
          "type": "es6"
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleFileExtensions": [
    "ts",
    "js",
    "json"
  ]
}
